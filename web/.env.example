# ---------------------------------------------------------------
# Public frontend configuration.
#
# Only values that are SAFE TO EXPOSE in a browser bundle belong
# here. Never put secret service keys in a VITE_ variable.
# ---------------------------------------------------------------

# Optional Django backend URL (leave empty when running standalone/cloud)
VITE_API_BASE_URL=

# Optional Supabase Cloud Database (Free Tier)
# Get these from Supabase Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Barber selection enabled
VITE_ENABLE_BARBER_SELECTION=true
